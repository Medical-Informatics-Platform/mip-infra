# Central cluster address used by the runbook scripts (setup-microk8s.sh, preflight.sh); not read by Helm.
#
# CENTRAL_GATEWAY_IP: the Submariner gateway LoadBalancer address pinned on the central cluster
# (common/submariner/operator/kustomization.yaml, spec.loadBalancerServiceAnnotations). The node
# exchanges IPsec only with this address. The same address is in the remote-nodes group of the
# hardening inventory (linux-server-management); change all three together.
CENTRAL_GATEWAY_IP=148.187.143.43
