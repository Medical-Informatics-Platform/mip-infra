# nginx configuration of the notebook API proxy. Rendered by the image entrypoint with envsubst
# limited to KUBERNETES_SERVICE_HOST and KUBERNETES_SERVICE_PORT (NGINX_ENVSUBST_FILTER), so
# every other $name below is an nginx variable.
#
# The JupyterHub pod of a federation talks to this proxy instead of the API server. The proxy
# forwards the hub's own Authorization header unchanged: RBAC and the admission policies of the
# API server remain the authorizers. The proxy only narrows what can be reached:
#
#   GET  POST        /apis/notebooks.mip.ebrains.eu/v1alpha1/namespaces/federation-<x>/notebooks
#   GET  DELETE      /apis/notebooks.mip.ebrains.eu/v1alpha1/namespaces/federation-<x>/notebooks/<name>
#   POST             /api/v1/namespaces/federation-<x>/secrets
#
# which is what the spawner uses (mip-jupyter docker/hub/notebook_spawner.py: get, create and
# delete of a Notebook, create of its token Secret). Everything else is answered 404 here.
# Locations match the normalized path ($uri) and forward that matched path, never the raw
# request URI, so the API server sees exactly what was allowed.
server_tokens off;

# The API server through the kubernetes Service address (an IP: no resolver needed).
upstream kube_apiserver {
    server ${KUBERNETES_SERVICE_HOST}:${KUBERNETES_SERVICE_PORT};
    keepalive 8;
}

# A variable in ssl_certificate makes nginx read the files at each handshake, so the certificate
# renewed by cert-manager (projected into the Secret volume) is served without a reload.
map $host $tls_dir {
    default /etc/notebook-api-proxy/tls;
}

server {
    listen 8443 ssl;
    server_name notebook-api-proxy.mip-notebooks-system.svc
                notebook-api-proxy.mip-notebooks-system.svc.cluster.local;

    ssl_certificate     $tls_dir/tls.crt;
    ssl_certificate_key $tls_dir/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;
    ssl_session_cache shared:SSL:1m;

    client_max_body_size 1m;
    client_body_buffer_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host kubernetes.default.svc;
    # Audit entries of the API server keep the hub pod address in sourceIPs.
    proxy_set_header X-Forwarded-For $remote_addr;
    # RBAC denies impersonation to the hub anyway; never forward the headers.
    proxy_set_header Impersonate-User "";
    proxy_set_header Impersonate-Group "";
    proxy_set_header Impersonate-Uid "";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 60s;
    proxy_intercept_errors off;
    # Upstream TLS, verified against the cluster CA (ConfigMap kube-root-ca.crt) with the
    # Service name as SNI and expected name.
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    proxy_ssl_server_name on;
    proxy_ssl_name kubernetes.default.svc;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_ssl_trusted_certificate /etc/notebook-api-proxy/ca/ca.crt;

    location = /healthz {
        return 200 "ok\n";
    }

    # Notebook objects of a federation: list and create on the collection, get and delete on one.
    location ~ "^(/apis/notebooks\.mip\.ebrains\.eu/v1alpha1/namespaces/federation-[a-z0-9-]+/notebooks(/[a-z0-9.-]+)?)$" {
        limit_except GET POST DELETE { deny all; }
        set $target $1;
        proxy_pass https://kube_apiserver$target$is_args$args;
    }

    # The per-server token Secret: create only.
    location ~ "^(/api/v1/namespaces/federation-[a-z0-9-]+/secrets)$" {
        limit_except POST { deny all; }
        set $target $1;
        proxy_pass https://kube_apiserver$target$is_args$args;
    }

    location / {
        return 404;
    }
}
